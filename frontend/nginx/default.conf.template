server {
    listen 5173;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # hashed Vite assets are safe to cache forever
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # same contract as the Vite dev proxy: /api -> the API, wherever it lives.
    # ${API_UPSTREAM} is substituted on container start.
    #
    # The upstream goes through a variable on purpose. Naming a host directly
    # in proxy_pass makes nginx resolve it once, at startup, and abort if it
    # does not exist yet — the web container would refuse to boot whenever the
    # API is down. Through a variable the name is resolved per request, so this
    # half starts and serves the app on its own and only /api returns 502.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        set                $api_upstream ${API_UPSTREAM};
        proxy_pass         $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # model inference on a cold cache can take a while
        proxy_read_timeout 120s;
    }

    # SPA: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
