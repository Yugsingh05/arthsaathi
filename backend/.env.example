# Postgres connection string. Everything the app reads and writes lives here:
# the dataset, the consent and decision ledger, and the trained model.
#
# Any Postgres works. This project is developed against Neon, whose pooled
# host contains "-pooler"; the seeder needs the direct host instead, which it
# derives by removing that. Set DATABASE_URL_UNPOOLED to override.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@direct-host/dbname?sslmode=require"
